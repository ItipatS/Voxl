# Copy this file to `.env` (same folder) and fill it in.
#
#     cp tools/textures/.env.example tools/textures/.env
#
# `.env` is gitignored — it will not be committed. Don't paste the key into
# chat, a commit message, or a Luau file.

# Make a key at https://create.roblox.com/dashboard/credentials
#   Access Permissions -> add the Assets API, operations: read + write
#   Pick your user (or the group, if textures should be group-owned)
#   Leave the IP allowlist EMPTY unless you have a static IP
ROBLOX_API_KEY=

# Your Roblox user id — the number in your profile URL:
#   https://www.roblox.com/users/<THIS NUMBER>/profile
# Optional: you can pass --user <id> on the command line instead. For group-owned
# uploads use --group <id>, and scope the API key to that group.
ROBLOX_USER_ID=
