-- Which blocks have a texture, and which are still flat colour?
--
-- Loads the REAL Blocks.luau (Roblox globals stubbed), reads every def's `tex`, and
-- writes tools/textures/WANTED.md — a shopping list of the filenames the uploader
-- expects, so producing textures is "make these files" rather than "read the code".
--
--   node tools/textures/names.js > /tmp/names.json     (Minecraft name suggestions)
--   lune run tools/textures/coverage.luau /tmp/names.json

local fs = require("@lune/fs")
local luau = require("@lune/luau")
local process = require("@lune/process")
local serde = require("@lune/serde")

local namesFile = process.args[1]

-- Roblox globals Blocks.luau touches. `script` is nil here, which the module
-- already guards for.
local env = [[
local Color3 = { fromRGB = function(r, g, b) return { r = r, g = g, b = b } end }
local Enum = setmetatable({}, { __index = function(_, k)
    return setmetatable({}, { __index = function(_, n) return { EnumItem = k .. "." .. n } end })
end })
]]
local Blocks = luau.load(env .. fs.readFile("src/Misc/Blocks.luau"), { debugName = "Blocks" })()

-- Blocks.luau applies Misc/BlockTextures over its defs at runtime, but that lookup
-- goes through `script.Parent`, which doesn't exist out here. Apply it by hand, or
-- this reports every uploaded texture as missing.
if fs.isFile("src/Misc/BlockTextures.luau") then
	local tex = luau.load(fs.readFile("src/Misc/BlockTextures.luau"), { debugName = "BlockTextures" })()
	local applied = 0
	for name, faces in tex do
		local id = Blocks.ID[name]
		local def = if id then Blocks.defs[id] else nil
		if def and faces.top then
			def.tex = { top = faces.top, side = faces.side or faces.top, bottom = faces.bottom or faces.top }
			applied += 1
		end
	end
	-- ...and slabs clone their parent before that happens in the real load order,
	-- so re-apply to them here too.
	for _, mat in Blocks.SLAB_MATERIALS do
		local parent = Blocks.defs[Blocks.ID[mat]]
		for _, variant in { "Slab", "SlabTop" } do
			local d = Blocks.defs[Blocks.ID[`{variant}_{mat}`]]
			if d and parent then
				d.tex = parent.tex
			end
		end
	end
	print(`applied {applied} generated textures`)
end

local mcNames: { [string]: { string } } = {}
if namesFile and fs.isFile(namesFile) then
	mcNames = serde.decode("json", fs.readFile(namesFile))
end

-- Blocks that need no texture of their own.
local function skipReason(name: string, def: any): string?
	if def.shape == "slab" then
		return "inherits its material's texture"
	end
	if name == "Water" or name == "Lava" then
		return "fluid — colour + material, no tile"
	end
	return nil
end

type Row = { name: string, id: number, textured: boolean, skip: string? }
local rows: { Row } = {}
for name, id in Blocks.ID do
	if id == 0 then
		continue
	end
	local def = Blocks.defs[id]
	if not def then
		continue
	end
	rows[#rows + 1] = {
		name = name,
		id = id,
		textured = def.tex ~= nil,
		skip = skipReason(name, def),
	}
end
table.sort(rows, function(a, b)
	return a.id < b.id
end)

local have, want, inherit = {}, {}, {}
for _, r in rows do
	-- `skip` wins over `textured`: Slab_Stone reports a texture because it cloned
	-- Stone's, which is exactly the inheritance working — it isn't a texture
	-- anyone has to make.
	if r.skip then
		table.insert(inherit, r)
	elseif r.textured then
		table.insert(have, r)
	else
		table.insert(want, r)
	end
end

-- ---- console summary ----
print(`{#rows} blocks: {#have} textured, {#want} still flat, {#inherit} need none`)
print("")
print(`HAVE ({#have}):`)
local line = "  "
for _, r in have do
	if #line + #r.name > 76 then
		print(line)
		line = "  "
	end
	line ..= r.name .. "  "
end
if line ~= "  " then
	print(line)
end

-- ---- WANTED.md ----
local md = {}
local function w(s: string)
	table.insert(md, s)
end

w("# Texture shopping list")
w("")
w("*Generated by `tools/textures/coverage.luau`. Re-run after uploading.*")
w("")
w(`| | |`)
w(`|---|---|`)
w(`| blocks | {#rows} |`)
w(`| textured | **{#have}** |`)
w(`| still flat colour | **{#want}** |`)
w(`| need no texture | {#inherit} (slabs inherit; fluids are flat) |`)
w("")
w("Drop files into one folder and run:")
w("")
w("```bash")
w("node tools/textures/upload.js --dir <folder> --user <yourId> --dry")
w("```")
w("")
w("Either filename works — the Voxl name, or the Minecraft one (a resource pack")
w("drops straight in). Add `_top` / `_side` / `_bottom` for per-face textures;")
w("no suffix means the same image on every face.")
w("")
w("---")
w("")
w(`## Still needed ({#want})`)
w("")
w("| block | file to make | or Minecraft name |")
w("|---|---|---|")
for _, r in want do
	local mc = mcNames[r.name]
	local hint = if mc and #mc > 0 then `\`{mc[1]}.png\`` else "—"
	w(`| \`{r.name}\` | \`{r.name}.png\` | {hint} |`)
end
w("")
w(`## Already textured ({#have})`)
w("")
for _, r in have do
	w(`- \`{r.name}\``)
end
w("")
w(`## Need no texture of their own ({#inherit})`)
w("")
w("Slabs take their parent material's texture automatically, so texturing")
w("`Quartz` also textures `Slab_Quartz` and `SlabTop_Quartz`.")
w("")
local byReason: { [string]: number } = {}
for _, r in inherit do
	byReason[r.skip :: string] = (byReason[r.skip :: string] or 0) + 1
end
for reason, n in byReason do
	w(`- {n} × {reason}`)
end

fs.writeFile("tools/textures/WANTED.md", table.concat(md, "\n") .. "\n")
print("")
print(`wrote tools/textures/WANTED.md — {#want} textures still needed`)
