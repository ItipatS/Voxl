-- ===== builder set (doc 23): flat-shaded, no textures yet =====
local M = Enum.Material
local function flat(id: number, name: string, color: Color3, material: Enum.Material, extra: { [string]: any }?)
    local d: any = { name = name, color = color, material = material, placeable = true }
    if extra then
        for k, v in extra do
            d[k] = v
        end
    end
    defs[id] = d
end

