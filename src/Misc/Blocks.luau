-- ===== uploaded textures =====
-- `Misc/BlockTextures` is GENERATED by tools/textures/upload.js: block name →
-- per-face asset ids, filled in as textures get uploaded. It's applied here, over
-- the defs but BEFORE slabs clone their parents, so a slab inherits its material's
-- texture for free. A block with no entry keeps its flat colour, so this is purely
-- additive — no re-bake, no id changes, nothing else to touch.
do
    -- `script` is guarded because this is a pure DATA module: it's loaded outside
    -- the DataModel by the id-parity test, and a registry shouldn't need an
    -- instance tree to describe itself.
    local this: any = script
    local parent = if this then this.Parent else nil
    -- WaitForChild, not FindFirstChild. On a CLIENT the children of Misc replicate
    -- independently, and Blocks is required early — so a plain lookup would often
    -- run before BlockTextures had arrived, find nothing, and silently leave every
    -- block flat-coloured. That failure is invisible: the world still renders, just
    -- with none of the uploaded art.
    local where = if parent then `{parent:GetFullName()}` else "(no script context)"
    local mod = if parent then parent:WaitForChild("BlockTextures", 10) else nil
    if mod and mod:IsA("ModuleScript") then
        local ok, tex = pcall(require, mod)
        if ok and type(tex) == "table" then
            local applied, skipped = 0, {}
            for name, faces in tex :: any do
                local id = ID[name]
                local d = if id then defs[id] else nil
                if d and faces.top then
                    d.tex = { top = faces.top, side = faces.side or faces.top, bottom = faces.bottom or faces.side or faces.top }
                    applied += 1
                elseif #skipped < 5 then
                    table.insert(skipped, `{name}({if id then "no def" else "no id"})`)
                end
            end
            local sample = defs[ID.Bricks]
            print(
                `[Blocks] applied {applied} textures from {where}.BlockTextures`
                    .. `; Bricks.tex = {if sample and sample.tex then sample.tex.top else "NONE"}`
            )
            if #skipped > 0 then
                warn(`[Blocks] {#skipped}+ entries had no matching block: {table.concat(skipped, ", ")}`)
            end
        else
            warn(`[Blocks] BlockTextures exists at {where} but failed to load — {tex}`)
        end
    elseif parent then
        warn(
            `[Blocks] no BlockTextures under {where} after 10s — every block that has no `
                .. "hand-entered TEX id will render as flat colour + material"
        )
    end
end

-- ===== slabs =====
-- Each takes its parent's colour, material and texture, and adds `shape = "slab"`,
-- which the mesher reads as "half height, and don't merge me vertically". They're
-- marked non-opaque so a neighbouring full block still draws the face a slab only
-- half covers — otherwise every slab would punch a hole in the wall behind it.
for _, mat in SLAB_MATERIALS do
    local parent = defs[ID[mat]]
    for _, variant in { "Slab", "SlabTop" } do
        local d: any = table.clone(parent :: any)
        d.name = `{parent.name} Slab`
        d.shape = "slab"
        d.top = variant == "SlabTop"
        d.opaque = false
        d.tex = parent.tex
        if d.top then
            d.name = `{parent.name} Slab (Top)`
        end
        defs[ID[`{variant}_{mat}`]] = d
    end
end

Blocks.defs = defs

-- ===== queries used across the codebase =====
function Blocks.def(id: number): BlockDef?
    return defs[id]
end

-- Does this block hide the neighbour face touching it? (Air + transparent = no.)
function Blocks.isOpaque(id: number): boolean
    if id == ID.Air then
        return false
    end
    local d = defs[id]
    return d ~= nil and d.opaque ~= false
end

function Blocks.isPlaceable(id: number): boolean
    local d = defs[id]
    return d ~= nil and d.placeable == true
end

-- Does this block collide? (Water/lava don't — you swim/fall through them.)
function Blocks.isSolid(id: number): boolean
    local d = defs[id]
    return d ~= nil and d.solid ~= false
end

-- id -> {top, bottom, side} (mesher/hotbar previews). Texture-less blocks are
-- absent from this table; callers already branch on nil and fall back to colour.
local BlockTextures: { [number]: { top: string, bottom: string, side: string } } = {}
for id, d in defs do
    local t = d.tex
    if t then
        BlockTextures[id] = { top = t.top, bottom = t.bottom, side = t.side }
    end
end
Blocks.BlockTextures = BlockTextures

return Blocks
