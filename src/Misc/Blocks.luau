local C = Color3.fromRGB

export type BlockDef = {
    name: string,
    -- Per-face textures, or nil for a flat-shaded block (colour + material only).
    -- The builder set ships texture-less on purpose: a debug-texture placeholder on
    -- 100 blocks looks far worse than clean flat colour, and the mesher/preview both
    -- already branch on "no texture".
    tex: { top: string, side: string, bottom: string }?,
    color: Color3, -- fill / fallback tint
    material: Enum.Material,
    render: string?, -- "cube" (default); "cross"/"vine"/"hang"/"fluid" arrive later
    opaque: boolean?, -- default true; false = neighbours behind it render (leaves/glass)
    alpha: number?, -- part transparency (1 = cutout via texture alpha)
    -- Leaves are SmoothPlastic, not LeafyGrass, and that is deliberate: the leaf
    -- texture already draws the leaves, so a PBR material underneath only adds
    -- shading work and a surface pattern showing through the cutout holes.
    -- SmoothPlastic is the cheapest thing to shade and stays out of the way.
    --
    -- Colour to use when this block is drawn WITHOUT its texture (distant chunks —
    -- see TEXTURE_RADIUS in ChunkClient). Only needed by blocks whose part is fully
    -- transparent and whose texture IS the block: leaves are alpha = 1 over a white
    -- part, so with no texture they would simply not exist. These are the real
    -- alpha-weighted mean colours of the leaf PNGs, so a canopy keeps its colour
    -- when it drops to flat shading. Untextured, the block is drawn opaque, which
    -- also takes far-away leaves out of the transparency sorting pass.
    lodColor: Color3?,
    solid: boolean?, -- default true (collision)
    -- Sub-block geometry. nil = a full cube; "slab" = half height, sitting at the
    -- bottom of its cell unless `top`. The mesher sizes and offsets the part, and
    -- refuses to merge slabs vertically (two stacked slabs are two half blocks,
    -- not one tall one).
    shape: string?,
    top: boolean?,
    placeable: boolean?, -- player may place it
    tintGrass: boolean?, -- top tinted by the biome grass colour
    light: number?, -- 0..15 emission (for the future lighting pass)
}

-- Both return nil when there's no texture id, so a def written as
-- `tex = uniform(TEX.gravel)` with no `gravel` entry simply becomes texture-less
-- (flat colour) instead of a table full of nils the mesher would choke on.
local function cube(top: string?, side: string?, bottom: string?)
    return if top then { top = top, side = side or top, bottom = bottom or top } else nil
end
local function uniform(t: string?)
    return if t then { top = t, side = t, bottom = t } else nil
end

