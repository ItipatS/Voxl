-- The four dyed families (Wool/Terracotta/Concrete/Glass × 16 dyes) are ids 73..136,
-- generated instead of typed out. The ORDER below is load-bearing: it fixes the ids,
-- and baked map data stores raw ids. Never reorder; append new dyes at the end only.
-- `tools/mcimport/voxlids.js` builds the identical table — keep the two in step.
local DYE_ORDER = {
    "white", "orange", "magenta", "light_blue", "yellow", "lime", "pink", "gray",
    "light_gray", "cyan", "purple", "blue", "brown", "green", "red", "black",
}
local DYED_FAMILIES = { "Wool", "Terracotta", "Concrete", "Glass" }
do
    local nextId = 73
    for _, fam in DYED_FAMILIES do
        for _, dye in DYE_ORDER do
            ID[`{fam}_{dye}`] = nextId
            nextId += 1
        end
    end
end
-- New ids append HERE, after the dyed families (73..136). Never renumber.
ID.IronBars = 137

-- Just more ordinary blocks — nothing special about them as a group. This list only
-- exists to hand out ids in a FIXED ORDER (138..155); once assigned, each is a block
-- exactly like Stone. They were added together because each had been collapsing onto
-- some other block and losing its character (deepslate reading as stone, magma as
-- glowstone, cactus as moss).
--
-- Deliberately NOT here: chest, barrel, crafting table, furnace. Those are
-- FUNCTIONAL blocks that doc 22 will build as real crafting stations, and a
-- decorative lookalike now would only be in the way. Imports map them to their
-- material, so a furnace built into a wall still leaves a wall, not a hole.
local BATCH_138 = {
    "Deepslate", "CobbledDeepslate", "DeepslateBricks", "Bedrock", "Tuff", "Calcite",
    "Basalt", "Blackstone", "Obsidian", "MagmaBlock", "Cactus",
    "CrackedStoneBricks", "ChiseledStoneBricks", "ChiseledQuartz",
    "Netherrack", "NetherBricks", "PolishedGranite", "PolishedDiorite",
}

-- HALF-HEIGHT SLABS. The voxel grid has one block per cell, so "a slab of X" has to
-- be its own id: one sitting on the floor, one on the ceiling (Minecraft's
-- type=bottom/top). A double slab is simply the full block. Stairs still collapse to
-- the full block — a stair's diagonal has nowhere to live in a cube grid — but slabs
-- are half a cube, which the mesher CAN draw, and buildings are full of them.
-- ORDER IS LOAD-BEARING, exactly like the dyed families.
local SLAB_MATERIALS = {
    "Stone", "Cobblestone", "StoneBricks", "SmoothStone", "Sandstone", "Quartz",
    "Bricks", "NetherBricks", "Diorite", "Andesite", "Granite",
    "OakPlanks", "SprucePlanks", "BirchPlanks", "JunglePlanks", "AcaciaPlanks",
    "DarkOakPlanks",
}

do
    local nextId = 138
    for _, name in BATCH_138 do
        ID[name] = nextId
        nextId += 1
    end
    for _, mat in SLAB_MATERIALS do
        ID[`Slab_{mat}`] = nextId
        ID[`SlabTop_{mat}`] = nextId + 1
        nextId += 2
    end
end

Blocks.ID = ID
Blocks.DYE_ORDER = DYE_ORDER
Blocks.SLAB_MATERIALS = SLAB_MATERIALS

