option ClientOutput = "src/std/ClientNet.luau"
option ServerOutput = "src/Server/ServerNet.luau"

struct ChunkCoord {
    cx: i16,
    cz: i16,
}

event LoadChunks {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: ChunkCoord[]
}

event UnloadChunks {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: string[]
}
