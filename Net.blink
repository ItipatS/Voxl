option ClientOutput = "src/std/ClientNet.luau"
option ServerOutput = "src/Server/ServerNet.luau"

struct ChunkCoord {
    cx: i16,
    cz: i16,
}

event LoadChunks {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: ChunkCoord[]
}

event UnloadChunks {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: string[]
}

-- One chunk of a BAKED star world (doc 23). Procedural terrain needs no data at
-- all — the client derives it from the seed — but an imported map is not derivable,
-- and shipping the whole thing to every client (in both places) is exactly what we
-- refuse to do. So the server keeps the map in ServerStorage and forwards single
-- chunk records, still DEFLATE'd, as players walk: ~540 bytes each, and a client
-- only ever receives the chunks it actually visits.
--
-- `raw` is the record's decompressed size, so the client can size the inflate
-- output up front. Sent immediately BEFORE the matching LoadChunks so the data is
-- always there by the time a chunk is meshed.
struct MapChunk {
    cx: i16,
    cz: i16,
    raw: u16,
    data: buffer
}

event MapChunks {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: MapChunk[]
}

-- A single block change: block 0 = broken (air), else the placed block id.
struct BlockEdit {
    wx: i32,
    y: i32,
    wz: i32,
    block: u8,
}

-- Client asks the server to break/place a block.
event EditBlock {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
    Data: BlockEdit
}

-- Server tells clients about applied edits (batched).
event BlockEdited {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: BlockEdit[]
}

-- Server sends the persisted world diff to a joining client (batched). Applied
-- without switching chunks to block mode (bulk load, not live editing).
event SyncDiff {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: BlockEdit[]
}

-- Client asks to drop a claim lock at their feet (server reads their position).
event PlaceLock {
    From: Client,
    Type: Reliable,
    Call: SingleSync
}

-- ---- Collectable star field (streamed near-player, like chunks) --------------
-- A streamed star: network id + absolute position (f32 — the field spans the
-- whole ~5000-radius area, too big for f16 precision).
struct StarState {
    id: u16,
    dp: vector<f32>,
}

-- Server streams positions of stars near each player. Unreliable: only new +
-- moving stars are sent each tick, latest position wins.
event StarStream {
    From: Server,
    Type: Unreliable,
    Call: SingleSync,
    Data: StarState[]
}

-- Server tells a client to drop streamed stars (out of range, or caught).
event StarUnload {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: u16[]
}

-- Client requests catching a star it's near; server validates proximity.
event StarCatch {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
    Data: u16
}

-- Server confirms a catch (the catching client plays the burst + removes it).
event StarCaught {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: u16
}

-- ---- Items (slot-based inventory, doc 20) -----------------------------------
-- One occupied slot: slot index (1-9 hotbar, 10-54 inventory) + itemdb id + count.
struct SlotEntry {
    slot: u8,
    item: u16,
    count: u32,
}

-- The player's item slots (occupied only) + derived weight budget. Pushed after
-- every change (one-writer/full-push). Blocks ride in here too: they are items
-- keyed block_<id> (itemdb), so there is exactly one inventory channel.
struct ItemInv {
    weight: u32,
    capacity: u32,
    slots: SlotEntry[],
}

-- Server pushes the player's slots + weight (on join and after any change).
event ItemSync {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: ItemInv
}

-- Client drags a stack between slots (pick up from `from`, drop on `to`); server
-- swaps/merges authoritatively.
struct MovePair {
    from: u8,
    to: u8,
}

event MoveItem {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
    Data: MovePair
}

-- Client right-clicks a slot to USE one (Consumables only); server validates.
event UseSlot {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
    Data: u8
}

-- ---- Planting a private star (doc 18) ---------------------------------------
-- Client proposes a name + grid cell (cx,cz indices). The server re-validates the
-- cell (plantable + unclaimed) and the name (globally unique), then commits.
struct PlantRequest {
    name: string,
    cx: i16,
    cz: i16,
}

event PlantStar {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
    Data: PlantRequest
}

-- Server verdict on a PlantStar request. reason is shown in the prompt's log on failure.
struct PlantResult {
    ok: boolean,
    reason: string,
}

event PlantStarResult {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: PlantResult
}

-- ---- Asteroids (streamed MOVING hazards, server-authoritative) --------------
-- Like the star field, but each asteroid drifts at a constant velocity, so we send
-- pos + vel ONCE on entry and the client dead-reckons (no per-tick position spam).
-- shape = index into ReplicatedStorage.Assets.Astroids children; size = world radius.
struct AsteroidState {
    id: u16,
    dp: vector<f32>,
    vel: vector<f32>,
    size: f32,
    shape: u8,
}

-- Server streams asteroids entering a player's range (with velocity to extrapolate).
event AsteroidStream {
    From: Server,
    Type: Unreliable,
    Call: SingleSync,
    Data: AsteroidState[]
}

-- Server tells a client to drop asteroids (left range, or respawned elsewhere).
event AsteroidUnload {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: u16[]
}

-- Server tells a client it was struck: unit knockback direction (world) + stun secs.
-- The server already applied the damage + owns the i-frame window; this is for FEEL
-- (freeze input, shove, flash, sfx).
struct AsteroidImpact {
    dir: vector<f32>,
    stun: f32,
}

event AsteroidHit {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: AsteroidImpact
}

-- ---- Star dust (seed-derived collectable field, chunk-model) ----------------
-- Dust positions are NOT sent — both sides generate them from a global seed per cell
-- (std/dust). Only the sparse "collected/cooling" deltas cross the wire. A mote is
-- addressed by its cell (cx,cy,cz) + local index.
struct MoteRef {
    cx: i16,
    cy: i16,
    cz: i16,
    idx: u8,
}

-- Client auto-collects when it flies through a mote → asks the server (which validates
-- proximity + that it isn't already cooling).
event DustCollect {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
    Data: MoteRef
}

-- (The collector no longer waits for a confirm — collect FEEL is instant client-side;
-- the server grants authoritative fuel via PlayerStateSync + broadcasts the dim below.)

-- A mote's cooldown (remaining in DECISECONDS, u16 → up to ~6553s). Sent to nearby
-- players so they dim it too — both as a live delta on collect AND as the batch a
-- player gets when they move into a new area (enter-sync).
struct MoteCool {
    ref: MoteRef,
    remaining: u16,
}

event DustCooldown {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: MoteCool[]
}

-- ---- Entering a procedural star (lobby → Star place) ------------------------
-- Client asks to enter the star in a universe SLOT; the lobby server validates (a star
-- exists there this week + the player is near it), then teleports them to the Star place
-- with that star's world config (seed/types) in TeleportData.
struct StarSlot {
    cx: i16,
    cy: i16,
    cz: i16,
}

-- Entering one of the five HUB-TOWNS. They aren't universe slots — they're fixed
-- constellation geography (std/constellation HUBS) — so they can't ride EnterStar,
-- which is keyed by slot. The index is all the client needs to send; the server
-- looks up the hub's world (baked map or rolled biomes) and validates the range.
event EnterHub {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
    Data: u8
}

event EnterStar {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
    Data: StarSlot
}

--- Server tells the entering client the trip is NOT happening (no star this week, too far,
--- or the teleport call failed — e.g. Studio/unpublished). The client reverses its iris
--- transition + clears the queued teleport GUI so the screen doesn't stay black.
event EnterDenied {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: u8
}

-- ---- Player runtime state (server-authoritative; client predicts + reconciles) ---
-- The server owns the authoritative status and pushes it to the OWNING client a few
-- times a second (Unreliable — latest wins). The client predicts locally for instant
-- feel (FlightBoost) and reconciles toward this. fuel = star fuel (0-100).
struct PlayerStatus {
    fuel: f32,
}

event PlayerStateSync {
    From: Server,
    Type: Unreliable,
    Call: SingleSync,
    Data: PlayerStatus
}

-- Client reports boost START/STOP EDGES (not a per-frame stream) so the server can
-- simulate authoritative fuel drain/regen to reconcile against.
event BoostState {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
    Data: boolean
}

-- ---- Crafting (doc 22) ------------------------------------------------------
-- Client requests a craft by recipe id; the server validates inputs (item slots), consumes
-- them and grants the output. (Station/time gating + factories layer on later.)
event Craft {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
    Data: string
}

-- ---- Holding items (hotbar → Tool in hand, doc 20) --------------------------
-- Client selects a hotbar Tool item to hold (itemdb id; 0 = unequip). The server
-- validates ownership + kind==Tool and spawns the replicated Tool on the character;
-- clients LOD its particles by distance. No broadcast needed — the Tool replicates.
event EquipItem {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
    Data: u16
}

-- ---- Leaving a star (star place → the Cluster lobby) ------------------------
-- The one way home. The client asks; the server teleports, because a client that
-- can pick its own teleport destination is a client that can teleport anywhere —
-- and the last client-side teleport in this codebase shipped a bug that silently
-- dropped every hub arrival into the test star.
event LeaveStar {
    From: Client,
    Type: Reliable,
    Call: SingleSync
}

-- Server could not send them home (teleport failed / rate-limited). The client
-- reopens the prompt and says so, instead of leaving a dead button.
event LeaveDenied {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: string
}
