option ClientOutput = "src/std/ClientNet.luau"
option ServerOutput = "src/Server/ServerNet.luau"

struct ChunkCoord {
    cx: i16,
    cz: i16,
}

event LoadChunks {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: ChunkCoord[]
}

event UnloadChunks {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: string[]
}

-- A single block change: block 0 = broken (air), else the placed block id.
struct BlockEdit {
    wx: i32,
    y: i32,
    wz: i32,
    block: u8,
}

-- Client asks the server to break/place a block.
event EditBlock {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
    Data: BlockEdit
}

-- Server tells clients about applied edits (batched).
event BlockEdited {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: BlockEdit[]
}

-- Server sends the persisted world diff to a joining client (batched). Applied
-- without switching chunks to block mode (bulk load, not live editing).
event SyncDiff {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: BlockEdit[]
}

-- One block type's owned count in a player's inventory.
struct BlockCount {
    block: u8,
    count: u32,
}

-- Server pushes the player's full block inventory (on join and after changes).
event InventorySync {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: BlockCount[]
}
