option ClientOutput = "src/std/ClientNet.luau"
option ServerOutput = "src/Server/ServerNet.luau"

map block = { [u32]: u8 }

map heightfield = { [u32]: u8 }

struct ChunkFull {
    cx: i16,
    cz: i16,
    blocks: block,
    heightfields: heightfield,
}

event ChunkFullStream {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: ChunkFull[]
}

event UnloadChunks {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: string[]
}